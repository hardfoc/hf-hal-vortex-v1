[submodule "lib/core"]
	path = lib/core
	url = https://github.com/hardfoc/hf-core.git
[submodule "examples/esp32/scripts"]
	path = examples/esp32/scripts
	url = https://github.com/hardfoc/hf-espidf-project-tools.git
[submodule "_config/doxygen-extensions/doxygen-awesome-css"]
	path = _config/doxygen-extensions/doxygen-awesome-css
	url = https://github.com/jothepro/doxygen-awesome-css.git
# hf-development-handbook is private, so CI cannot clone it. "update = none"
# keeps "git submodule update --init --recursive" from trying; with access, run
#   git submodule update --init --checkout docs/hf-development-handbook
[submodule "docs/hf-development-handbook"]
	path = docs/hf-development-handbook
	url = https://github.com/hardfoc/hf-development-handbook.git
	update = none
[submodule "third_party/CANopenNode"]
	path = third_party/CANopenNode
	url = https://github.com/CANopenNode/CANopenNode.git
